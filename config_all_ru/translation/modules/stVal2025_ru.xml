        <message key="sv25ValentineMsg11">Ты — мой путеводный свет</message>
        <message key="sv25ValentineMsg12">Ты освещаешь мой мир</message>
        <message key="sv25ValentineMsg13">Моему источнику вдохновения</message>
        <message key="sv25ValentineMsg14">У меня есть ты — и это прекрасно</message>
        <message key="sv25ValentineMsg15">Ты делаешь меня лучше</message>
        <message key="sv25ValentineMsg16">Моей путеводной звезде</message>
